# Copy this file to  .env  and fill in MASTER_KEY.
# .env itself is never committed - it is in .gitignore.

# ---------------------------------------------------------------
# REQUIRED
# ---------------------------------------------------------------

# Where PostgreSQL is. Change the password to match your install.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sih_dms

# REQUIRED. 64 hexadecimal characters, generated once and never changed.
# Generate one with:
#     node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# This key locks every stored document. Lose it and every document ever
# uploaded becomes permanently unreadable - which is the point of it,
# but it means you should back it up somewhere other than this machine.
MASTER_KEY=

# ---------------------------------------------------------------
# OPTIONAL - the defaults are fine for a demo
# ---------------------------------------------------------------

PORT=5000

# Only needed when the screens are served from a different address than
# the API. When one process serves both, this is unused.
CORS_ORIGIN=http://localhost:5173

# stub   = in-memory, runs anywhere, proves nothing
# fabric = the real two-organisation ledger, see fabric/README.md
LEDGER_BACKEND=stub

# Leave false until you have looked at real redacted output yourself.
# Text files are redacted properly; images and PDFs are refused either
# way, so switching this on cannot make an unsupported format leak.
REDACTION_ENABLED=false

# disk  = a local folder. Fine on a laptop. WRONG on a cloud host, where
#         the folder is wiped every time the app restarts.
# minio = S3-compatible write-once storage. Use this anywhere real.
STORAGE_BACKEND=disk

# Only read when STORAGE_BACKEND=minio
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=nyayakosh

# Languages for reading scanned pages. Only add one you have actually
# tested with a real sample.
OCR_LANGS=eng+hin
